 "poems": [
  {
   "seq": "1",
   "text": "戀しさのねてや忘るゝと思へとも又名殘そふ夢のおもかけ",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "をのつから夢と知りても如何せむ只うたゝれにみつる名殘は",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "はかなしやつれなき人もうちとけてみゆとはしらぬ夢の通ち",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "袖にせく涙なからの手枕におもかけかよふうたゝねのゆめ",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "あたにみて覺ぬる夢の面かけをうつゝの後もなをのこさはや",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "をのつからぬるか中なる佛もみるとしもなき夢そはかなき",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "佛もしらてやこひむぬるかうちにみるを夢とて賴まさりせは",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "逢ふとみし夢のたよりにならひてもまとろむ程を猶や賴まん",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "いさや猶契をくともたのまれすゆく末まての人の〓とのは",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "人しれす其かね〓との忘れぬやあらは逢よのたのみ成らん",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "今は又思ひたえぬる道なれやあらはれにけるよそのせき守",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "絕はつる人の契のつらきにそもれしうき名は猶もかなしき",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "そのまゝに又もかよはぬ契にそ今はなき名と人はしるらん",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "今しはし忍ひもはてぬくやしさもみしかゝりける契にそしる",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "今は又かけてもとはすうき名よにもらさむまての契なりけり",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "憂さ名をは歎かさらまし人しれす忍ひし程にたえもはてなは",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "忘れしよけふやあすやとしらねともいきて命のあらむ限りは",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "かはり行心ならはとたのむ哉つらきなからのよゝのかねこと",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "ありへはとたのむはかりに契りても消なはあたの露の〓とのは",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "憂き身世にあらは逢よと契らすはなからへてもと賴まさらまし",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "さためなき命のうちの契りたに猶ゆく末はしりかたのよや",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "さためなき命のうちはたのまれすいつはりならぬ契り成とも",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "ありし名のたつたにおしき我中をさて絕ぬとは人にしられし",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "忘らるゝうき名はそへし人しれぬ情のこして絕なましかは",
   "kana": "",
   "speaker": "",
   "page": 343,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
